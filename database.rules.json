{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "projects": {
      "$projectId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "tasks": {
          ".indexOn": [
            "columnId",
            "position",
            "updatedAt",
            "projectId"
          ]
        },
        "columns": {
          ".indexOn": [
            "position",
            "projectId"
          ]
        },
        "_syncInfo": {
          ".indexOn": [
            "lastSyncAt",
            "taskCount"
          ]
        }
      }
    }
  }
}