rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Gestão de Projetos utiliza Google Cloud SQL PostgreSQL como persistência relacional
    // e Realtime Database para live sync. Regras padrão para Firestore:
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
